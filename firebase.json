{
  
"functions": {
  "source": "functions",
  "runtime": "nodejs20"
},



  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,

    "rewrites": [
      {
        "source": "/api{,/**}",
        "function": "api"
      }
    ]
  },

  "firestore": {
    "rules": "firestore.rules"
  },

  "storage": {
    "rules": "storage.rules"
  },

  "emulators": {
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4010
    },

    "functions": {
      "host": "127.0.0.1",
      "port": 5005
    },

    "hosting": {
      "host": "127.0.0.1",
      "port": 5002
    },

    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },

    "auth": {
      "host": "127.0.0.1",
      "port": 9095
    },

    "storage": {
      "host": "127.0.0.1",
      "port": 9200
    },

    "hub": {
      "host": "127.0.0.1",
      "port": 4405
    },

    "logging": {
      "host": "127.0.0.1",
      "port": 4505
    }
  }
}